// Шаблон для локальных секретов.
// Скопируй файл рядом под именем Secrets.xcconfig и подставь свой ключ:
//
//   cp Configs/Secrets.example.xcconfig Configs/Secrets.xcconfig
//
// Secrets.xcconfig лежит в .gitignore и в репозиторий не попадает.
// Ключ берётся на RapidAPI: https://rapidapi.com/spoonacular/api/recipe-food-nutrition

SPOONACULAR_API_KEY = PUT_YOUR_RAPIDAPI_KEY_HERE
